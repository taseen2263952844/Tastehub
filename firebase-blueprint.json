{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "An e-commerce product listed on the VEYRA storefront.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "minLength": 2, "maxLength": 140 },
        "slug": { "type": "string", "maxLength": 140 },
        "categoryId": { "type": "string", "maxLength": 64 },
        "categoryName": { "type": "string", "maxLength": 80 },
        "price": { "type": "number" },
        "compareAtPrice": { "type": "number" },
        "shortDescription": { "type": "string", "maxLength": 300 },
        "description": { "type": "string", "maxLength": 4000 },
        "images": { "type": "string", "description": "Image URLs list" },
        "stock": { "type": "number" },
        "sku": { "type": "string", "maxLength": 64 },
        "variations": { "type": "string", "description": "Variations list" },
        "isFeatured": { "type": "boolean" },
        "isNewArrival": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" },
        "popularityScore": { "type": "number" },
        "isActive": { "type": "boolean" },
        "seoTitle": { "type": "string", "maxLength": 160 },
        "seoDescription": { "type": "string", "maxLength": 320 },
        "supplierName": { "type": "string", "maxLength": 60 },
        "supplierProductId": { "type": "string", "maxLength": 120 },
        "supplierPrice": { "type": "number" },
        "supplierStock": { "type": "number" },
        "supplierLastSyncedAt": { "type": "string", "format": "date-time" },
        "supplierCategory": { "type": "string", "maxLength": 100 },
        "supplierMarkupType": { "type": "string", "enum": ["percentage", "fixed", "custom"] },
        "supplierMarkupValue": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "categoryId", "price", "description", "stock", "isActive"]
    },
    "Category": {
      "title": "Category",
      "description": "A VEYRA product category.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "slug": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 300 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "displayOrder": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["name", "slug", "isActive"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated customer profile with saved addresses.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 24 },
        "savedAddresses": { "type": "string", "maxLength": 10000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Cart": {
      "title": "Cart",
      "description": "Synchronized persistent cart for an authenticated customer.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "items": { "type": "string", "maxLength": 20000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "items"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order submitted on VEYRA.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 48 },
        "orderNumber": { "type": "string", "maxLength": 32 },
        "userId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "customerPhone": { "type": "string", "minLength": 11, "maxLength": 20 },
        "customerEmail": { "type": "string", "maxLength": 120 },
        "city": { "type": "string", "maxLength": 80 },
        "area": { "type": "string", "maxLength": 100 },
        "deliveryAddress": { "type": "string", "maxLength": 350 },
        "deliveryInstructions": { "type": "string", "maxLength": 350 },
        "paymentMethod": { "type": "string", "enum": ["cash_on_delivery", "bkash_manual", "nagad_manual"] },
        "paymentStatus": { "type": "string", "enum": ["Unpaid", "Pending Verification", "Paid", "Refunded"] },
        "paymentReference": { "type": "string", "maxLength": 120 },
        "items": { "type": "string" },
        "itemCount": { "type": "number" },
        "subtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "discountAmount": { "type": "number" },
        "promoCode": { "type": "string", "maxLength": 40 },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Confirmed", "Processing", "Shipped", "Delivered", "Cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderNumber", "customerName", "customerPhone", "city", "area", "deliveryAddress", "paymentMethod", "paymentStatus", "items", "subtotal", "deliveryFee", "totalAmount", "status"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Homepage hero or editorial promotional banner.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 160 },
        "subtitle": { "type": "string", "maxLength": 400 },
        "ctaText": { "type": "string", "maxLength": 60 },
        "targetCategory": { "type": "string", "maxLength": 64 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "isActive": { "type": "boolean" },
        "displayOrder": { "type": "number" }
      },
      "required": ["title", "isActive"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Global storefront configuration, theme customizer, header/footer layout, SEO, delivery rates, and payment details.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "storeName": { "type": "string", "maxLength": 80 },
        "tagline": { "type": "string", "maxLength": 160 },
        "insideDhakaDeliveryFee": { "type": "number" },
        "outsideDhakaDeliveryFee": { "type": "number" },
        "freeDeliveryThreshold": { "type": "number" }
      },
      "required": ["storeName", "insideDhakaDeliveryFee", "outsideDhakaDeliveryFee"]
    },
    "WebsiteSection": {
      "title": "WebsiteSection",
      "description": "Configurable homepage visual builder section.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "type": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 120 },
        "heading": { "type": "string", "maxLength": 200 },
        "isVisible": { "type": "boolean" },
        "displayOrder": { "type": "number" }
      },
      "required": ["id", "type", "name", "isVisible", "displayOrder"]
    },
    "WebsiteVersion": {
      "title": "WebsiteVersion",
      "description": "Draft, published, or archived storefront configuration snapshot.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "versionLabel": { "type": "string", "maxLength": 120 },
        "publishedBy": { "type": "string", "maxLength": 120 }
      },
      "required": ["id", "versionLabel"]
    },
    "NavigationMenu": {
      "title": "NavigationMenu",
      "description": "Header, footer, or custom navigation menu with nested dropdown items.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 80 },
        "location": { "type": "string", "enum": ["header", "footer", "custom"] }
      },
      "required": ["id", "name", "location"]
    },
    "CmsPage": {
      "title": "CmsPage",
      "description": "Custom storefront page (About, FAQ, Policies, Landing pages).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 160 },
        "slug": { "type": "string", "maxLength": 140 },
        "content": { "type": "string", "maxLength": 40000 },
        "status": { "type": "string", "enum": ["draft", "published"] }
      },
      "required": ["title", "slug", "content", "status"]
    },
    "CmsPost": {
      "title": "CmsPost",
      "description": "Blog article, announcement, campaign, or news post.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 180 },
        "slug": { "type": "string", "maxLength": 160 },
        "postType": { "type": "string", "enum": ["blog", "announcement", "product_highlight", "campaign", "news"] },
        "content": { "type": "string", "maxLength": 50000 },
        "status": { "type": "string", "enum": ["draft", "published", "scheduled"] },
        "publishDate": { "type": "string", "maxLength": 64 }
      },
      "required": ["title", "slug", "postType", "content", "status"]
    },
    "Promotion": {
      "title": "Promotion",
      "description": "Promo code, sale label, or free delivery campaign.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 40 },
        "title": { "type": "string", "maxLength": 120 },
        "discountType": { "type": "string", "enum": ["percentage", "fixed", "free_delivery"] },
        "discountValue": { "type": "number" },
        "minOrderAmount": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["code", "title", "discountType", "discountValue", "isActive"]
    },
    "MediaAsset": {
      "title": "MediaAsset",
      "description": "Centralized media asset stored in Firebase Storage or external HTTPS URL.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 80 },
        "name": { "type": "string", "maxLength": 160 },
        "url": { "type": "string", "maxLength": 1200 },
        "folder": { "type": "string", "maxLength": 40 }
      },
      "required": ["name", "url", "folder"]
    },
    "NewsletterSubscriber": {
      "title": "NewsletterSubscriber",
      "description": "Customer email subscribed to VEYRA newsletter updates.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 160 },
        "source": { "type": "string", "enum": ["footer", "section"] },
        "status": { "type": "string", "enum": ["subscribed", "unsubscribed"] }
      },
      "required": ["email", "source", "status"]
    },
    "SupplierIntegration": {
      "title": "SupplierIntegration",
      "description": "Configuration and sync state for an external supplier integration (secrets are never stored here).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "supplierName": { "type": "string", "maxLength": 60 },
        "status": { "type": "string", "enum": ["connected", "unconfigured", "error"] },
        "lastTestedAt": { "type": "string", "maxLength": 64 },
        "lastSyncedAt": { "type": "string", "maxLength": 64 },
        "lastError": { "type": "string", "maxLength": 500 },
        "defaultMarkupType": { "type": "string", "enum": ["percentage", "fixed", "custom"] },
        "defaultMarkupValue": { "type": "number" },
        "defaultCategoryId": { "type": "string", "maxLength": 64 },
        "defaultPublishStatus": { "type": "string", "enum": ["draft", "published"] },
        "importedCount": { "type": "number" }
      },
      "required": ["id", "supplierName", "status"]
    },
    "SupplierImportLog": {
      "title": "SupplierImportLog",
      "description": "Audit log for supplier product imports and manual synchronization runs.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 80 },
        "supplierName": { "type": "string", "maxLength": 60 },
        "mode": { "type": "string", "enum": ["selected", "category", "sync"] },
        "categoryFilter": { "type": "string", "maxLength": 100 },
        "totalProcessed": { "type": "number" },
        "createdCount": { "type": "number" },
        "updatedCount": { "type": "number" },
        "skippedCount": { "type": "number" },
        "failedCount": { "type": "number" },
        "triggeredBy": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "supplierName", "mode", "totalProcessed", "createdCount", "updatedCount", "skippedCount", "failedCount", "triggeredBy", "createdAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Public product catalog managed by administrators."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Storefront categories managed by administrators."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private customer profiles and saved addresses."
    },
    "/carts/{userId}": {
      "schema": { "$ref": "#/entities/Cart" },
      "description": "Synchronized shopping carts for authenticated customers."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "E-commerce orders readable by owner or authorized administrators."
    },
    "/banners/{bannerId}": {
      "schema": { "$ref": "#/entities/Banner" },
      "description": "Homepage banners managed by administrators."
    },
    "/storeSettings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSettings" },
      "description": "Store configuration including delivery fees, theme, header/footer, and SEO settings."
    },
    "/websiteSections/{sectionId}": {
      "schema": { "$ref": "#/entities/WebsiteSection" },
      "description": "Visual homepage builder sections."
    },
    "/websiteVersions/{versionId}": {
      "schema": { "$ref": "#/entities/WebsiteVersion" },
      "description": "Draft, published, and archived storefront configurations."
    },
    "/navigationMenus/{menuId}": {
      "schema": { "$ref": "#/entities/NavigationMenu" },
      "description": "Navigation menus for header and footer."
    },
    "/pages/{pageId}": {
      "schema": { "$ref": "#/entities/CmsPage" },
      "description": "Custom storefront pages (drafts visible only to admins; published pages public)."
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/CmsPost" },
      "description": "Blog articles and announcements (draft/scheduled visible only to admins; published posts public)."
    },
    "/promotions/{promoId}": {
      "schema": { "$ref": "#/entities/Promotion" },
      "description": "Active discount codes and campaigns."
    },
    "/media/{assetId}": {
      "schema": { "$ref": "#/entities/MediaAsset" },
      "description": "Centralized media library metadata managed by administrators."
    },
    "/newsletterSubscribers/{subscriberId}": {
      "schema": { "$ref": "#/entities/NewsletterSubscriber" },
      "description": "Newsletter email subscribers (write-only for public visitors, readable only by admins)."
    },
    "/supplierIntegrations/{integrationId}": {
      "schema": { "$ref": "#/entities/SupplierIntegration" },
      "description": "Admin-only supplier integration statuses and markup defaults."
    },
    "/supplierImportLogs/{logId}": {
      "schema": { "$ref": "#/entities/SupplierImportLog" },
      "description": "Admin-only history logs of supplier imports and catalog syncs."
    }
  }
}
