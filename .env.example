# GEMINI_API_KEY: Required for server-side Gemini OCR question extraction.
# Configure in AI Studio Secrets or Cloudflare Worker -> Settings -> Variables and Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Application base URL
APP_URL="MY_APP_URL"

# Firebase Authentication Configuration (Client-side Auth ONLY)
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="tastehub-16c49.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="tastehub-16c49"
VITE_FIREBASE_STORAGE_BUCKET="tastehub-16c49.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="MY_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="MY_FIREBASE_APP_ID"

# Supabase Public Client Configuration (Safe for frontend with RLS enabled)
VITE_SUPABASE_URL="https://cvymhhqfjazbtelgncys.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Supabase Server-Side Configuration (SERVER-SIDE ONLY — NEVER prefix with VITE_!)
