{
  "name": "tastehub",
  "main": "./server/worker.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SUPABASE_URL": "https://cvymhhqfjazbtelgncys.supabase.co",
    "FIREBASE_PROJECT_ID": "tastehub-16c49"
  }
}
